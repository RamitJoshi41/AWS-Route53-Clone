# Copy to .env to override defaults.
# SQLAlchemy URL; defaults to backend/route53.db (absolute path) when unset.
# DATABASE_URL=sqlite:////absolute/path/to/route53.db
# Comma-separated origins allowed to call the API directly from a browser.
CORS_ORIGINS=http://localhost:3000
# Deployed (Render): CORS_ORIGINS=https://<app>.vercel.app
# How long a login session lasts (fixed, not extended by activity).
# SESSION_TTL_HOURS=12
# Set to true when served over HTTPS so the session cookie is only sent on secure connections.
# COOKIE_SECURE=false
# Deployed (Render): COOKIE_SECURE=true (set in render.yaml)
